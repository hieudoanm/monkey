{
  "name": "monkey-c",
  "displayName": "Monkey C",
  "description": "Monkey C and Jungle syntax highlighting, formatting, dark color theme, and file icons for Garmin Connect IQ.",
  "version": "0.0.1",
  "publisher": "hieudoanm",
  "author": "hieudoanm",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "vscode": "1.147.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Themes"
  ],
  "keywords": [
    "monkey c",
    "monkeyc",
    "jungle",
    "garmin",
    "connect iq",
    "watchface",
    "syntax highlighting",
    "formatter"
  ],
  "icon": "icons/png/monkey-c.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hieudoanm/monkey"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:monkeyc",
    "onLanguage:jungle",
    "onCommand:monkeyc.formatDocument",
    "onCommand:monkeyc.runtimePreview",
    "onCommand:monkeyc.build",
    "onCommand:monkeyc.run",
    "onCommand:monkeyc.test",
    "onCommand:monkeyc.export",
    "onCommand:monkeyc.debug",
    "onCommand:monkeyc.clean",
    "onCommand:monkeyc.projectInfo",
    "onCommand:monkeyc.doctor"
  ],
  "contributes": {
    "languages": [
      {
        "id": "monkeyc",
        "aliases": [
          "Monkey C",
          "monkeyc"
        ],
        "extensions": [
          ".mc",
          ".mb",
          ".mcgen"
        ],
        "configuration": "./languages/monkeyc/language-configuration.json",
        "icon": {
          "light": "./icons/svg/monkey-c-on-light.svg",
          "dark": "./icons/svg/monkey-c-on-dark.svg"
        }
      },
      {
        "id": "jungle",
        "aliases": [
          "Jungle",
          "jungle"
        ],
        "extensions": [
          ".jungle"
        ],
        "configuration": "./languages/jungle/language-configuration.json",
        "icon": {
          "light": "./icons/svg/monkey-c-on-light.svg",
          "dark": "./icons/svg/monkey-c-on-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "monkeyc",
        "scopeName": "source.monkeyc",
        "path": "./syntaxes/monkey-c.tmLanguage.json"
      },
      {
        "language": "jungle",
        "scopeName": "source.jungle",
        "path": "./syntaxes/jungle.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "id": "monkey-c",
        "label": "Monkey C",
        "uiTheme": "vs-dark",
        "path": "./themes/monkey-c-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "monkey-c-icons",
        "label": "Monkey C Icons",
        "path": "./icons/monkey-c-icon-theme.json"
      }
    ],
    "commands": [
      {
        "title": "Format Document",
        "command": "monkeyc.formatDocument",
        "category": "Monkey C"
      },
      {
        "title": "Runtime Preview (Simulator)",
        "command": "monkeyc.runtimePreview",
        "category": "Monkey C"
      },
      {
        "title": "Build PRG",
        "command": "monkeyc.build",
        "category": "Monkey C"
      },
      {
        "title": "Build and Run (Simulator)",
        "command": "monkeyc.run",
        "category": "Monkey C"
      },
      {
        "title": "Test",
        "command": "monkeyc.test",
        "category": "Monkey C"
      },
      {
        "title": "Export .iq",
        "command": "monkeyc.export",
        "category": "Monkey C"
      },
      {
        "title": "Debug (Monkeybrains)",
        "command": "monkeyc.debug",
        "category": "Monkey C"
      },
      {
        "title": "Clean Build Output",
        "command": "monkeyc.clean",
        "category": "Monkey C"
      },
      {
        "title": "Project Info",
        "command": "monkeyc.projectInfo",
        "category": "Monkey C"
      },
      {
        "title": "Doctor (SDK/Key Check)",
        "command": "monkeyc.doctor",
        "category": "Monkey C"
      }
    ],
    "breakpoints": [
      {
        "language": "monkeyc"
      }
    ],
    "configurationDefaults": {
      "[monkeyc]": {
        "editor.defaultFormatter": "hieudoanm.monkey-c"
      },
      "[jungle]": {
        "editor.defaultFormatter": "hieudoanm.monkey-c"
      }
    },
    "configuration": {
      "title": "Monkey C",
      "properties": {
        "monkeyC.sdkPath": {
          "type": "string",
          "default": "",
          "description": "Path to Connect IQ SDK root (contains bin/monkeyc, bin/monkeydo, bin/connectiq)."
        },
        "monkeyC.developerKeyPath": {
          "type": "string",
          "default": "",
          "description": "Path to Connect IQ developer key (.der) used for simulator builds."
        },
        "monkeyC.previewDevice": {
          "type": "string",
          "default": "fr55",
          "description": "Connect IQ device id used for runtime preview builds/launches."
        },
        "monkeyC.cliPath": {
          "type": "string",
          "default": "monkey",
          "description": "Path to the monkey CLI used for lint diagnostics and Monkey C commands (build/run/test/export/…)."
        },
        "monkeyC.lintEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Run monkey lint diagnostics on Monkey C/Jungle documents."
        },
        "monkeyC.lspEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Use `monkey lsp` for diagnostics and language features (hover, completion, go-to-definition, rename). Falls back to lint-only diagnostics when the CLI is unavailable."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -watch -p .",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "pnpm run build",
    "package": "vsce package --no-dependencies",
    "test:format": "node -e \"const f=require('./out/format-monkeyc'); console.log(f.formatMonkeyC('class A{function x(){return 1;}}')); console.log(f.formatJungle('a=b'))\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/vscode": "1.146.0",
    "@vscode/vsce": "4.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "vscode-languageclient": "11.0.1"
  }
}
